{
    "name": "magpern/universal-support-chat",
    "description": "Universal Support Chat for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "UniversalSupportChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UniversalSupportChat\\Tests\\": "tests/unit/",
            "UniversalSupportChat\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check-doc-links": "php bin/check-doc-links.php docs README.md"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
